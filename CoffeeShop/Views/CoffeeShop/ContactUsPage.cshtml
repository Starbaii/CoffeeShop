@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}


<nav class="brown" style="margin: 0; padding: 0;">
    <div class="nav-wrapper left-align" style="padding: 0 20px;">
        <img src="~/Content/pictures/kape logo.png" style="float:left; width: 70px; height: auto;" alt="Kape Logo" />
        <span style="font-size: 1.5rem; font-family: 'Hibernate'; color: #fff3e0; line-height: 70px; margin-left: 10px;">
            GETCOFFEE SHOP
        </span>

        <ul class="right hide-on-med-and-down">
            <li><a href="@Url.Action("Homepage", "CoffeeShop")">Home</a></li>
            <li><a href="@Url.Action("AboutPage", "CoffeeShop")">About Us</a></li>
            <li><a href="@Url.Action("MenuPage", "CoffeeShop")">Menu</a></li>
            <li><a href="@Url.Action("CoffeeCollectivesPage", "CoffeeShop")">GetCoffee Collective</a></li>
            <li><a href="@Url.Action("RegistrationPage", "CoffeeShop")"><i class="large material-icons">account_circle</i></a></li>

        </ul>
    </div>
</nav>

<body style="margin:0;
       padding:0;
       background-image: url('/Content/pictures/kape bg.jpg');
       background-size: cover;
       background-position: center;
       background-repeat: no-repeat;
       height: 138vh;">
    <img src="~/Content/pictures/kape logo.png"
         style="float: left;
width: 700px;
height: auto;
margin-left: -40px;
margin-top: -30px;" />
    <h3 style="text-align: center; color: #fff3e0; font-family: 'Playfair Display', serif; margin-top: 40px;">
        We’d love to hear from you
    </h3>
    <textarea placeholder="Subject"
              class="card-panel orange lighten-5"
              style="width: 700px;
              height: 40px;
              border-radius: 20px;
              position: absolute;
              top: 180px;
              left: 770px;
              padding: 10px 10px;
              border: none;"></textarea>
    <textarea placeholder="First Name"
              class="card-panel orange lighten-5"
              style="width: 700px;
            height: 40px;
            border-radius: 20px;
            position: absolute;
            top: 240px;
            left: 770px;
            padding: 10px 10px;
            border: none;"></textarea>
    <textarea placeholder="Last Name"
              class="card-panel orange lighten-5"
              style="width: 700px;
        height: 40px;
        border-radius: 20px;
        position: absolute;
        top: 300px;
        left: 770px;
        padding: 10px 10px;
        border: none;
        resize: none"></textarea>

    <textarea placeholder="Your Message"
              class="card-panel orange lighten-5"
              style="width: 700px;
                 height: 300px;
                 border-radius: 20px;
                 position: absolute;
                 top: 360px;
                 left: 770px;
                 padding: 20px 10px 0 10px;
                 border: none;
                 resize: none;"></textarea>
    <button class="btn waves-effect waves-light orange lighten-5"
            style="position: absolute;
               top: 690px;
               left: 770px;
               color: #000000;">
        Submit
    </button>

    <footer style="background-color: rgba(255, 224, 178, 0.95); color: #4e342e; padding: 20px 0; text-align: center; position: relative; margin-top: 810px;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <p style="margin: 0; font-family: 'Arima', system-ui;">
                © 2025 GETCOFFEE. All rights reserved.
            </p>
        </div>
    </footer>
</body>
