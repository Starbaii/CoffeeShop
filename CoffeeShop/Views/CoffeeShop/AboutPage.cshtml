    /* ============================================
    FIX FOR ORDER HISTORY BUTTONS ON DESKTOP
    ============================================ */

    /* Ensure table container allows scrolling */
    .table-container {
    overflow-x: auto !important;
    overflow-y: visible !important;
    position: relative;
    width: 100%;
    }

    /* Make the order-history table responsive */
    .order-history {
    overflow-x: auto;
    width: 100%;
    }

    /* Data table responsive fix */
    .data-table,
    .order-table {
    width: 100%;
    min-width: 800px;
    border-collapse: separate;
    border-spacing: 0;
    }

    /* Fix for action buttons container */
    .order-actions-cell {
    display: flex !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
    justify-content: flex-start !important;
    align-items: center !important;
    min-width: 200px !important;
    }

    /* Ensure buttons are always clickable */
    .history-action-btn,
    .action-btn,
    .add-btn,
    .download-btn {
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 10;
    }

    /* Make sure table cells don't clip content */
    .data-table td,
    .order-table td {
    overflow: visible !important;
    white-space: normal !important;
    word-break: normal !important;
    }

    /* Sticky action column for large screens */
    @@media (min-width: 1200px) {
