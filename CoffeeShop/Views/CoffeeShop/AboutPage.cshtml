        // Download Report Function
        function downloadReport() {
            const html = `
                                    <div class="form-header">
                                        <div class="form-header-icon">
                                            <i class="fas fa-download"></i>
                                        </div>
                                        <div class="form-header-text">
                                            <div class="form-header-title">Download Report</div>
                                            <div class="form-header-subtitle">Select report type and period</div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Report Type</label>
                                        <div class="button-group" id="reportTypeGroup">
                                            <button type="button" class="option-btn selected" data-value="sales">Sales Report</button>
                                            <button type="button" class="option-btn" data-value="inventory">Inventory Report</button>
                                            <button type="button" class="option-btn" data-value="employees">Employee Report</button>
                                            <button type="button" class="option-btn" data-value="orders">Order Report</button>
                                        </div>
                                        <input type="hidden" id="selectedReportType" value="sales">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Report Period</label>
                                        <div class="button-group" id="reportPeriodGroup">
                                            <button type="button" class="option-btn selected" data-value="daily">Daily</button>
                                            <button type="button" class="option-btn" data-value="weekly">Weekly</button>
                                            <button type="button" class="option-btn" data-value="monthly">Monthly</button>
                                            <button type="button" class="option-btn" data-value="yearly">Yearly</button>
                                        </div>
                                        <input type="hidden" id="selectedReportPeriod" value="daily">
                                    </div>
                                `;

            Swal.fire({
                title: '',
                html: html,
                showCancelButton: true,
                confirmButtonText: 'Download',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#A8A54A',
                cancelButtonColor: '#6F4E37',
                width: 550,
                backdrop: 'rgba(111, 78, 55, 0.1)',
                didOpen: () => {
                    // Add click handlers for report type buttons
                    const typeButtons = document.querySelectorAll('#reportTypeGroup .option-btn');
                    const typeHiddenInput = document.getElementById('selectedReportType');

                    typeButtons.forEach(btn => {
                        btn.addEventListener('click', function () {
                            typeButtons.forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                            typeHiddenInput.value = this.getAttribute('data-value');
                        });
                    });

                    // Add click handlers for report period buttons
                    const periodButtons = document.querySelectorAll('#reportPeriodGroup .option-btn');
                    const periodHiddenInput = document.getElementById('selectedReportPeriod');

                    periodButtons.forEach(btn => {
                        btn.addEventListener('click', function () {
                            periodButtons.forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                            periodHiddenInput.value = this.getAttribute('data-value');
                        });
                    });
                },
                preConfirm: () => {
                    const type = document.getElementById('selectedReportType').value;
                    const period = document.getElementById('selectedReportPeriod').value;
                    return { type, period };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Report Generated!',
                        text: `Your ${result.value.period} ${result.value.type} report is ready for download.`,
                        icon: 'success',
                        confirmButtonColor: '#A8A54A',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            });
        }

        // Navigation Function
        function showPage(page) {
            // Hide all pages
