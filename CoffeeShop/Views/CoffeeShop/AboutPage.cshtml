                                            <td><strong>${log.name}</strong></td>
                                            <td>${log.role}</td>
                                            <td>${log.module}</td>
                                            <td><span class="status-badge" style="background: rgba(168, 165, 74, 0.1); color: var(--color-accent);">${log.action}</span></td>
                                            <td>${log.description}</td>
                                        </tr>
                                    `;
                tableBody.innerHTML += row;
            });
        }

