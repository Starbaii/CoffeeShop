@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<style>
    .swal2-container, .sweet-alert {
        z-index: 20000 !important;
    }
</style>

<div ng-controller="CoffeeShopController"
     ng-init="setAdminUser('@ViewBag.AdminName')"
     style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #f5f1ed; z-index: 9999; display: flex; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden;">

    <aside style="width: 260px; background: linear-gradient(135deg, #6b4423 0%, #4a2c15 100%); padding: 30px 20px; box-shadow: 4px 0 15px rgba(0, 0, 0, 0.1); display: flex; flex-direction: column; flex-shrink: 0; color: white;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 50px;">
            <img src="~/Content/pictures/kape logo.png" alt="Logo"
                 style="width: 50px; height: 50px; border-radius: 50%; border: 2px solid #d4a574; object-fit: cover; background: white;">
            <span style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700;">{{ appName }}</span>
        </div>
        <ul style="list-style: none; padding: 0; margin: 0; flex: 1;">
            <li ng-repeat="item in menuItems" style="margin-bottom: 8px;">
                <a href="#" ng-click="setActive(item)"
                   ng-style="item.active ? {'background-color': '#d4a574', 'color': '#3e2723', 'font-weight': '600'} : {'color': '#e0e0e0'}"
                   style="display: flex; align-items: center; gap: 15px; padding: 14px 20px; text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-size: 15px;">
                    <i class="material-icons" style="font-size: 22px;">{{ item.icon }}</i>
                    <span>{{ item.label }}</span>
                </a>
            </li>
        </ul>
        <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1);">
            <a href="#" ng-click="logout()"
               style="display: flex; align-items: center; gap: 15px; padding: 12px 20px; color: #ffab91; text-decoration: none; font-weight: 500;">
                <i class="material-icons">logout</i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative;">

        <header style="background-color: white; padding: 20px 40px; box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
            <h1 style="font-size: 26px; font-weight: 700; color: #4a2c15; margin: 0; font-family: 'Playfair Display', serif;">
                {{ dashboardTitle }}
            </h1>
            <div style="display: flex; align-items: center; gap: 15px; padding: 8px 15px; background: #fdfbf7; border: 1px solid #efebe9; border-radius: 30px;">
                <div style="width: 36px; height: 36px; background-color: #6b4423; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                    {{ adminUser.initial }}
                </div>
                <span style="color: #5d4037; font-weight: 600; padding-right: 10px;">{{ adminUser.name }}</span>
            </div>
        </header>

        <div style="flex: 1; padding: 40px; overflow-y: auto;">

            <div ng-show="dashboardTitle === 'Dashboard'">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 25px; margin-bottom: 40px;">
                    <div ng-repeat="stat in stats" style="background-color: white; padding: 25px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);">
                        <div style="margin-bottom: 15px; width: 50px; height: 50px; background-color: #fef8f3; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="material-icons" style="font-size: 26px; color: #6b4423;">{{ stat.icon }}</i>
                        </div>
                        <div style="font-size: 13px; color: #aca098; font-weight: 600; text-transform: uppercase;">{{ stat.label }}</div>
                        <div style="font-size: 32px; font-weight: 700; color: #4a2c15; font-family: 'Playfair Display', serif;">
                            <span ng-if="stat.label === 'Products'">{{ products.length }}</span>
                            <span ng-if="stat.label !== 'Products'">{{ stat.value }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div ng-show="dashboardTitle === 'Add Product'">
                <div style="display: flex; gap: 30px; align-items: flex-start; flex-wrap: wrap;">

                    <div style="flex: 1; min-width: 320px; background-color: white; padding: 35px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);">
                        <h2 style="color: #4a2c15; margin: 0 0 25px 0; font-family: 'Playfair Display', serif;">Add New Item</h2>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500;">Product Name</label>
                            <input type="text" ng-model="newProduct.ProductName" style="width: 100%; padding: 12px; border: 1px solid #e0e0e0; border-radius: 8px; box-sizing: border-box; background-color: #fff;">
                        </div>

                        <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 8px; font-weight: 500;">Price (₱)</label>
                                <input type="number" ng-model="newProduct.ProductPrice" style="width: 100%; padding: 12px; border: 1px solid #e0e0e0; border-radius: 8px; box-sizing: border-box; height: 45px;">
                            </div>
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 8px; font-weight: 500;">Category</label>
                                <select class="browser-default" ng-model="newProduct.ProductCategory" style="display: block !important; visibility: visible !important; width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; background-color: #ffffff; height: 45px; -webkit-appearance: menulist; appearance: menulist; color: #333;">
                                    <option value="" disabled selected>-- Select Category --</option>
                                    <option value="Hot Coffee">Hot Coffee</option>
                                    <option value="Merchandise">Merchandise</option>
                                </select>
                            </div>
                        </div>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500;">Description</label>
                            <textarea ng-model="newProduct.ProductDescription" rows="3" style="width: 100%; padding: 12px; border: 1px solid #e0e0e0; border-radius: 8px; box-sizing: border-box; font-family: sans-serif; resize: vertical;"></textarea>
                        </div>

                        <div style="margin-bottom: 25px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500;">Image</label>
                            <input type="file" onchange="angular.element(this).scope().uploadProductImage(this)">
                            <img ng-if="productImagePreview" ng-src="{{productImagePreview}}" style="margin-top: 10px; max-width: 100px; border-radius: 8px; border: 1px solid #ddd;">
                        </div>

                        <button ng-click="addProduct()" style="width: 100%; background: #6b4423; color: white; padding: 14px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; justify-content: center;">
                            <i class="material-icons" style="margin-right: 8px;">add_circle</i> Save to Menu
                        </button>
                    </div>

                    <div style="flex: 1.5; min-width: 450px; background-color: white; padding: 35px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);">
                        <h2 style="color: #4a2c15; margin: 0 0 25px 0; font-family: 'Playfair Display', serif;">Current Menu</h2>
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                            <thead>
                                <tr>
                                    <th style="text-align: left; padding: 15px; border-bottom: 2px solid #f5f1ed;">ITEM</th>
                                    <th style="text-align: left; padding: 15px; border-bottom: 2px solid #f5f1ed;">NAME</th>
                                    <th style="text-align: left; padding: 15px; border-bottom: 2px solid #f5f1ed;">CATEGORY</th>
                                    <th style="text-align: left; padding: 15px; border-bottom: 2px solid #f5f1ed;">PRICE</th>
                                    <th style="text-align: right; padding: 15px; border-bottom: 2px solid #f5f1ed;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="p in products">
                                    <td style="padding: 15px; border-bottom: 1px solid #f5f5f5;">
                                        <img ng-src="{{p.ProductImageUrl ? p.ProductImageUrl : '/Content/pictures/black coffee.png'}}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                                    </td>
                                    <td style="padding: 15px; border-bottom: 1px solid #f5f5f5;">
                                        <div style="font-weight: 600;">{{p.ProductName}}</div>
                                        <div style="font-size: 12px; color: #999; margin-top: 4px;">{{p.ProductDescription | limitTo: 30}}{{p.ProductDescription.length > 30 ? '...' : ''}}</div>
                                    </td>
                                    <td style="padding: 15px; border-bottom: 1px solid #f5f5f5;">
                                        <span style="background-color: #f0ebe5; color: #6b4423; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                            {{p.ProductCategory}}
                                        </span>
                                    </td>
                                    <td style="padding: 15px; border-bottom: 1px solid #f5f5f5;">₱{{p.ProductPrice}}</td>
                                    <td style="padding: 15px; border-bottom: 1px solid #f5f5f5; text-align: right;">

                                        <button ng-click="deleteProduct(p.ProductID); $event.currentTarget.blur()"
                                                style="background-color: #fff1f0; color: #e57373; border: none; padding: 8px; border-radius: 8px; cursor: pointer;">
                                            <i class="material-icons">delete</i>
                                        </button>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div ng-if="products.length == 0" style="text-align: center; padding: 20px; color: #999;">No items found.</div>
                    </div>
                </div>
            </div>

            <div ng-show="dashboardTitle === 'Charts'">
                <div style="background-color: white; padding: 35px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); height: 500px;">
                    <h2 style="color: #4a2c15; margin: 0 0 25px 0; font-family: 'Playfair Display', serif;">Weekly Sales Analytics</h2>
                    <div style="position: relative; height: 400px; width: 100%;">
                        <canvas id="bar" class="chart chart-bar"
                                chart-data="chartData" chart-labels="chartLabels"
                                chart-series="chartSeries" chart-colors="chartColors"
                                chart-options="chartOptions" chart-dataset-override="datasetOverride">
                        </canvas>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>