@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div ng-controller="CoffeeShopController"
     ng-init="loadCartItems()"
     style="margin:0; padding:40px 0; background-image: url('@Url.Content("~/Content/pictures/kape bg.jpg")'); background-size: cover; background-position: center; background-repeat: no-repeat; min-height: 100vh; width: 100%;">

    <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">

        <div style="background: rgba(255, 243, 224, 0.95); backdrop-filter: blur(10px); border-radius: 20px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">

            <h4 style="margin-bottom: 10px; font-family: 'Playfair Display', serif; color: #4e342e; font-size: 2.8rem; font-weight: 700;">Shopping Cart</h4>
            <p style="color: #8d6e63; margin-bottom: 40px; font-family: 'Lora', serif; font-size: 1.1rem;">Review your items and complete your order</p>

            <div style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start;">

                <div style="background: white; border-radius: 16px; padding: 0; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">

                    <div style="background: #fcfcfc; border-bottom: 1px solid #eee; padding: 20px 30px; display: flex; justify-content: space-between;">
                        <span style="font-family: 'Lora', serif; font-weight: 600; color: #8d6e63;">Product</span>
                        <span style="font-family: 'Lora', serif; font-weight: 600; color: #8d6e63;">Total</span>
                    </div>

                    <div id="cartItemsContainer" ng-show="cartItems.length > 0">
                        <div ng-repeat="item in cartItems"
                             style="display: flex; align-items: center; justify-content: space-between; padding: 25px 30px; border-bottom: 1px solid #f0f0f0; transition: background 0.2s;">

                            <div style="display: flex; align-items: center; gap: 25px;">
                                <div style="width: 90px; height: 90px; border-radius: 12px; overflow: hidden; background: #f5f5f5; flex-shrink: 0; border: 1px solid #eee;">

                                    <img ng-src="{{item.OrderImage}}"
                                         ng-show="item.OrderImage"
                                         style="width: 100%; height: 100%; object-fit: cover;">

                                    <div ng-hide="item.OrderImage" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                        <i class="material-icons" style="color: #d7ccc8; font-size: 40px;">coffee</i>
                                    </div>
                                </div>

                                <div>
                                    <h5 style="margin: 0 0 5px 0; font-family: 'Playfair Display', serif; color: #3e2723; font-size: 1.3rem; font-weight: 600;">
                                        {{item.OrderName}}
                                    </h5>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <span style="color: #8d6e63; font-family: 'Lora', serif; font-size: 0.95rem;">Size: <strong>{{item.OrderSize}}</strong></span>
                                        <span style="color: #8d6e63; font-family: 'Lora', serif; font-size: 0.95rem;">Qty: <strong>{{item.OrderQuantity}}</strong></span>
                                    </div>
                                </div>
                            </div>

                            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 8px;">
                                <div style="font-weight: 700; color: #3e2723; font-size: 1.25rem; font-family: 'Playfair Display', serif;">
                                    ₱ {{item.OrderPrice | number:2}}
                                </div>

                                <button ng-click="removeItem($index, item.OrderID)"
                                        style="background: transparent; border: 1px solid #ef9a9a; color: #d32f2f; border-radius: 20px; padding: 5px 15px; font-size: 0.8rem; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 5px;"
                                        onmouseover="this.style.background='#ffebee'"
                                        onmouseout="this.style.background='transparent'">
                                    <i class="material-icons" style="font-size: 14px;">delete_outline</i>
                                    Remove
                                </button>
                            </div>

                        </div>
                    </div>

                    <div id="emptyCartMessage" ng-show="cartItems.length == 0" style="text-align: center; padding: 60px 20px;">
                        <div style="background: #fcfcfc; width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                            <i class="material-icons" style="font-size: 50px; color: #d7ccc8;">shopping_cart</i>
                        </div>
                        <h5 style="font-family: 'Playfair Display', serif; color: #4e342e; font-size: 1.5rem; margin-bottom: 10px;">Your cart is empty</h5>
                        <a href="@Url.Action("MenuPage", "CoffeeShop")"
                           style="color: #8d6e63; font-weight: 600; text-decoration: none; border-bottom: 2px solid #d7ccc8;">
                            Start Shopping
                        </a>
                    </div>
                </div>

                <div>
                    <div style="background: white; border-radius: 16px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); position: sticky; top: 20px;">
                        <h5 style="font-family: 'Playfair Display', serif; color: #3e2723; font-size: 1.5rem; margin-bottom: 25px; font-weight: 700; border-bottom: 1px solid #eee; padding-bottom: 15px;">
                            Order Summary
                        </h5>

                        <div style="margin-bottom: 25px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 1.05rem; color: #5d4037; font-family: 'Lora', serif;">
                                <span>Subtotal</span>
                                <span>₱ {{grandTotal | number:2}}</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; font-size: 1.4rem; font-weight: 700; color: #3e2723; border-top: 2px dashed #d7ccc8; padding-top: 20px; margin-top: 10px;">
                                <span>Total</span>
                                <span>₱ {{grandTotal | number:2}}</span>
                            </div>
                        </div>

                        <h6 style="font-family: 'Lora', serif; color: #5d4037; font-size: 1rem; margin-bottom: 15px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Payment Method</h6>

                        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px;">
                            <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 12px 15px; border: 1px solid #eee; border-radius: 10px; transition: all 0.2s;"
                                   ng-class="{'selected-payment': selectedPayment === 'Pick Up on Store'}"
                                   ng-style="selectedPayment === 'Pick Up on Store' ? {'background': '#efebe9', 'border-color': '#8d6e63'} : {}">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="payment" value="Pick Up on Store" ng-model="selectedPayment" ng-click="selectPayment('Pick Up on Store')">
                                    <span style="font-weight: 500; color: #4e342e;">Pick Up on Store</span>
                                </div>
                                <i class="material-icons" style="color: #8d6e63;">store</i>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 12px 15px; border: 1px solid #eee; border-radius: 10px; transition: all 0.2s;"
                                   ng-class="{'selected-payment': selectedPayment === 'GCash'}"
                                   ng-style="selectedPayment === 'GCash' ? {'background': '#efebe9', 'border-color': '#8d6e63'} : {}">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="payment" value="GCash" ng-model="selectedPayment" ng-click="selectPayment('GCash')">
                                    <span style="font-weight: 500; color: #4e342e;">GCash</span>
                                </div>
                                <i class="material-icons" style="color: #007bff;">account_balance_wallet</i>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 12px 15px; border: 1px solid #eee; border-radius: 10px; transition: all 0.2s;"
                                   ng-class="{'selected-payment': selectedPayment === 'Credit/Debit Card'}"
                                   ng-style="selectedPayment === 'Credit/Debit Card' ? {'background': '#efebe9', 'border-color': '#8d6e63'} : {}">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="payment" value="Credit/Debit Card" ng-model="selectedPayment" ng-click="selectPayment('Credit/Debit Card')">
                                    <span style="font-weight: 500; color: #4e342e;">Credit/Debit Card</span>
                                </div>
                                <i class="material-icons" style="color: #3949ab;">credit_card</i>
                            </label>
                        </div>

                        <button ng-click="completeOrder()"
                                style="background: #3e2723; color: white; width: 100%; padding: 18px 0; font-size: 1.1rem; border: none; border-radius: 30px; cursor: pointer; font-family: 'Lora', serif; font-weight: 600; box-shadow: 0 8px 20px rgba(62, 39, 35, 0.25); transition: transform 0.2s;"
                                onmouseover="this.style.transform='translateY(-2px)'"
                                onmouseout="this.style.transform='translateY(0)'">
                            Complete Order
                        </button>

                        <div style="text-align: center; margin-top: 20px;">
                            <a href="@Url.Action("MenuPage", "CoffeeShop")" style="color: #8d6e63; text-decoration: none; font-size: 0.9rem;">Continue Shopping</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>