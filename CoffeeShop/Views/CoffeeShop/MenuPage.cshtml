@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div style="width: 100%; min-height: 100vh; margin: 0; padding: 0; background-image: url('/Content/pictures/kape bg.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; background-attachment: fixed;">

    <div style="max-width: 1400px; margin: 0 auto; padding: 40px 20px 100px;">

        <h3 style="text-align: center; color: #fff3e0; font-family: 'Playfair Display', serif; font-size: 3rem; margin: 40px 0 50px; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);">
            COFFEE PRODUCTS
        </h3>

        <div id="productsContainer" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; padding: 20px;">

            <div ng-repeat="p in menuList | startFrom:currentPage*pageSize | limitTo:pageSize"
                 ng-click="openProductModal(p)"
                 style="background: rgba(255, 243, 224, 0.95); border-radius: 20px; overflow: hidden; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer;"
                 onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 12px 30px rgba(0, 0, 0, 0.4)'"
                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.3)'">

                <div style="background: linear-gradient(135deg, #4e342e 0%, #3e2723 100%); height: 280px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
                    <img ng-src="{{p.Image}}" alt="{{p.Name}}"
                         style="width: 80%; height: auto; max-height: 250px; object-fit: contain; transition: transform 0.4s ease; position: relative; z-index: 1; filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.3));"
                         onmouseover="this.style.transform='scale(1.1) rotate(-5deg)'"
                         onmouseout="this.style.transform='scale(1) rotate(0deg)'">
                </div>

                <div style="padding: 25px; text-align: center;">
                    <h5 style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.5rem; margin: 0 0 10px 0; font-weight: 600;">{{p.Name}}</h5>
                    <p style="color: #6d4c41; font-size: 1.3rem; font-weight: bold; font-family: 'Arima', serif; margin: 0;">
                        <span style="color: #8d6e63; font-size: 1rem;">₱</span> {{p.BasePrice}}
                    </p>
                </div>
            </div>

        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 50px;">

            <button id="prevBtn"
                    ng-click="prevPage()"
                    ng-disabled="currentPage == 0"
                    ng-style="currentPage == 0 ? {'opacity': '0.5', 'cursor': 'not-allowed'} : {'opacity': '1', 'cursor': 'pointer'}"
                    style="background: rgba(255, 243, 224, 0.95); color: #3e2723; border: none; padding: 12px 24px; border-radius: 10px; font-size: 1rem; font-family: 'Playfair Display', serif; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);">
                ← Previous
            </button>

            <div id="pageInfo" style="color: #fff3e0; font-family: 'Arima', serif; font-size: 1.1rem; font-weight: 600; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); min-width: 120px; text-align: center;">
                Page {{currentPage+1}} of {{numberOfPages()}}
            </div>

            <button id="nextBtn"
                    ng-click="nextPage()"
                    ng-disabled="currentPage >= menuList.length/pageSize - 1"
                    ng-style="currentPage >= menuList.length/pageSize - 1 ? {'opacity': '0.5', 'cursor': 'not-allowed'} : {'opacity': '1', 'cursor': 'pointer'}"
                    style="background: rgba(255, 243, 224, 0.95); color: #3e2723; border: none; padding: 12px 24px; border-radius: 10px; font-size: 1rem; font-family: 'Playfair Display', serif; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);">
                Next →
            </button>
        </div>
    </div>

    <div id="productModal" ng-show="isModalOpen" style="display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.8); z-index: 1000; align-items: center; justify-content: center; padding: 20px; overflow-y: auto;">

        <div style="background: linear-gradient(to bottom, #fff3e0 0%, #ffe0b2 100%); max-width: 900px; width: 100%; border-radius: 30px; box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5); position: relative; margin: 20px auto; animation: slideDown 0.4s ease-out;">

            <button ng-click="closeProductModal()"
                    style="position: absolute; top: 20px; right: 20px; background: #3e2723; color: #fff3e0; border: none; width: 45px; height: 45px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3); z-index: 10; transition: all 0.3s ease;"
                    onmouseover="this.style.background='#4e342e'; this.style.transform='rotate(90deg) scale(1.1)'"
                    onmouseout="this.style.background='#3e2723'; this.style.transform='rotate(0deg) scale(1)'">
                ✕
            </button>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; padding: 40px;">

                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <div style="background: linear-gradient(135deg, #4e342e 0%, #3e2723 100%); width: 100%; height: 400px; border-radius: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); overflow: hidden;">
                        <img ng-src="{{selectedProduct.Image}}" alt="Product" style="width: 85%; height: auto; max-height: 380px; object-fit: contain; filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.4));">
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; justify-content: space-between;">

                    <div>
                        <h2 style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 2.5rem; margin: 0 0 15px 0; font-weight: 700;">{{selectedProduct.Name}}</h2>

                        <p style="color: #6d4c41; font-size: 1.1rem; line-height: 1.6; margin: 0 0 25px 0; font-family: 'Arima', serif;">
                            {{selectedProduct.Description}}
                        </p>

                        <div style="margin-bottom: 25px;">
                            <h4 style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.3rem; margin: 0 0 15px 0;">Choose Size:</h4>
                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">

                                <button ng-click="selectSize('Small')"
                                        ng-style="selectedSize === 'Small' ? {'background': '#d7ccc8', 'border-color': '#5d4037'} : {'background': '#fff'}"
                                        style="border: 3px solid #8d6e63; padding: 15px 10px; border-radius: 12px; cursor: pointer; text-align: center; transition: all 0.3s ease;">
                                    <div style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 5px;">Small</div>
                                    <div style="color: #6d4c41; font-family: 'Arima', serif; font-size: 1rem; font-weight: 600;">₱ {{selectedProduct.BasePrice - 20}}</div>
                                </button>

                                <button ng-click="selectSize('Medium')"
                                        ng-style="selectedSize === 'Medium' ? {'background': '#d7ccc8', 'border-color': '#5d4037'} : {'background': '#fff'}"
                                        style="border: 3px solid #8d6e63; padding: 15px 10px; border-radius: 12px; cursor: pointer; text-align: center; transition: all 0.3s ease;">
                                    <div style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 5px;">Medium</div>
                                    <div style="color: #6d4c41; font-family: 'Arima', serif; font-size: 1rem; font-weight: 600;">₱ {{selectedProduct.BasePrice}}</div>
                                </button>

                                <button ng-click="selectSize('Large')"
                                        ng-style="selectedSize === 'Large' ? {'background': '#d7ccc8', 'border-color': '#5d4037'} : {'background': '#fff'}"
                                        style="border: 3px solid #8d6e63; padding: 15px 10px; border-radius: 12px; cursor: pointer; text-align: center; transition: all 0.3s ease;">
                                    <div style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 5px;">Large</div>
                                    <div style="color: #6d4c41; font-family: 'Arima', serif; font-size: 1rem; font-weight: 600;">₱ {{selectedProduct.BasePrice + 20}}</div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h4 style="color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.3rem; margin: 0 0 15px 0;">Quantity:</h4>
                        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px;">

                            <button ng-click="adjustQuantity(-1)"
                                    style="background: #8d6e63; color: #fff; border: none; width: 45px; height: 45px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);"
                                    onmouseover="this.style.background='#6d4c41'; this.style.transform='scale(1.1)'"
                                    onmouseout="this.style.background='#8d6e63'; this.style.transform='scale(1)'">
                                −
                            </button>

                            <div style="background: #fff; border: 2px solid #8d6e63; width: 80px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #3e2723; font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 600;">
                                {{orderQuantity}}
                            </div>

                            <button ng-click="adjustQuantity(1)"
                                    style="background: #8d6e63; color: #fff; border: none; width: 45px; height: 45px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);"
                                    onmouseover="this.style.background='#6d4c41'; this.style.transform='scale(1.1)'"
                                    onmouseout="this.style.background='#8d6e63'; this.style.transform='scale(1)'">
                                +
                            </button>
                        </div>

                        <button ng-click="addToCart()"
                                style="background: linear-gradient(135deg, #6d4c41 0%, #4e342e 100%); color: #fff3e0; border: none; padding: 18px; border-radius: 15px; font-size: 1.3rem; font-family: 'Playfair Display', serif; font-weight: 600; cursor: pointer; width: 100%; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3); transition: all 0.3s ease;"
                                onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 30px rgba(0, 0, 0, 0.4)'"
                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(0, 0, 0, 0.3)'">
                            🛒 Add to Cart - ₱ {{totalPrice}}
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <footer style="background-color: rgba(255, 224, 178, 0.95); color: #4e342e; padding: 20px 0; text-align: center; position: relative; margin-top: 50px;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <p style="margin: 0; font-family: 'Arima', system-ui;">
                © 2025 GETCOFFEE. All rights reserved.
            </p>
        </div>
    </footer>

</div>