        // Function to show SweetAlert order modal
        function showOrderModal1(productId) {
            const product = products.find(p => p.id === productId);
            const isDrink = ['coffee', 'non-coffee', 'frappes'].includes(product.category);

            let html = `
                                        <div class="order-form-group">
                                            <label class="order-form-label">Quantity</label>
                                            <input type="number" id="quantity" class="order-form-input" value="1" min="1" max="10">
                                        </div>`;

            html += `
                                        <div class="order-form-group">
                                            <label class="order-form-label">Order Type</label>
                                            <div class="button-group" id="orderTypeGroup">
                                                <button type="button" class="option-btn selected" data-value="dine-in">Dine In</button>
                                                <button type="button" class="option-btn" data-value="takeout">Takeout</button>
                                            </div>
                                        </div>
                                        <div class="order-form-group">
                                            <label class="order-form-label">Add-ons (Optional)</label>
                                            <div class="addons-container" id="addonsContainer">`;

            // Filter add-ons based on product category
            const relevantAddons = isDrink
                ? addOns.filter(a => a.category === "drink")
                : addOns.filter(a => a.category === "food");

            relevantAddons.forEach(addon => {
                html += `
                                            <div class="addon-item" id="addonItem-${addon.id}">
                                                <input type="checkbox" id="addon-${addon.id}" class="addon-checkbox" value="${addon.id}" data-name="${addon.name}" data-price="${addon.price}">
                                                <label for="addon-${addon.id}" class="addon-label">${addon.name} (+&#8369; ${addon.price})</label>
                                            </div>`;
            });

            html += `</div></div>`;

            Swal.fire({
                title: `Add ${product.name}`,
                html: html,
                showCancelButton: true,
                confirmButtonText: 'Add to Order',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#A8A54A',
                cancelButtonColor: '#6F4E37',
                width: 600,
                padding: '3em',
                backdrop: `rgba(111, 78, 55, 0.1)`,
                didOpen: () => {
                    // Add click handlers for order type buttons
                    const orderTypeButtons = document.querySelectorAll('#orderTypeGroup .option-btn');
                    orderTypeButtons.forEach(btn => {
                        btn.addEventListener('click', function () {
                            orderTypeButtons.forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                        });
                    });

                    // FIX: Add visual feedback for add-on checkboxes
                    const checkboxes = document.querySelectorAll('.addon-checkbox');
                    checkboxes.forEach(checkbox => {
                        checkbox.addEventListener('change', function () {
                            const addonItem = this.closest('.addon-item');
                            if (this.checked) {
                                addonItem.classList.add('selected');
                            } else {
                                addonItem.classList.remove('selected');
                            }
                        });
                    });
                },
                preConfirm: () => {
                    const quantity = parseInt(document.getElementById('quantity').value);
                    if (quantity < 1 || quantity > 10) {
                        Swal.showValidationMessage('Please enter a quantity between 1 and 10');
                        return false;
                    }

                    // Get selected order type
                    const selectedOrderType = document.querySelector('#orderTypeGroup .option-btn.selected');
                    const orderType = selectedOrderType ? selectedOrderType.getAttribute('data-value') : 'dine-in';

                    // Get selected addons
                    let selectedAddons = [];
                    const checkboxes = document.querySelectorAll('.addon-checkbox:checked');
                    checkboxes.forEach(checkbox => {
                        selectedAddons.push({
                            id: parseInt(checkbox.value),
                            name: checkbox.getAttribute('data-name'),
                            price: parseInt(checkbox.getAttribute('data-price'))
                        });
                    });

                    return {
                        productId: productId,
                        quantity: quantity,
                        orderType: orderType,
                        addons: selectedAddons
                    };
                }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    addToOrder(result.value);
                }
            });
        }

        // Function to add item to order
        function addToOrder1(orderData) {
            const product = products.find(p => p.id === orderData.productId);

            // Calculate total price with addons
            let addonsTotal = 0;
            orderData.addons.forEach(addon => {
                addonsTotal += addon.price;
            });

            const totalPrice = (product.price + addonsTotal) * orderData.quantity;

            const orderItem = { // Unique ID for each order item
                productId: product.id,
                name: product.name,
                image: product.image,
                category: product.category,
                quantity: orderData.quantity,
                orderType: orderData.orderType,
                addons: orderData.addons,
                unitPrice: product.price,
                addonsPrice: addonsTotal,
                totalPrice: totalPrice
            };

            // Check if similar item exists (same product, orderType, and addons)
            const existingIndex = currentOrder.findIndex(item =>
                item.productId === orderItem.productId &&
                item.orderType === orderItem.orderType &&
                JSON.stringify(item.addons.map(a => a.id).sort()) ===
                JSON.stringify(orderItem.addons.map(a => a.id).sort())
            );

            if (existingIndex > -1) {
                // Update quantity of existing item
                currentOrder[existingIndex].quantity += orderItem.quantity;
                currentOrder[existingIndex].totalPrice =
                    (currentOrder[existingIndex].unitPrice + currentOrder[existingIndex].addonsPrice) *
                    currentOrder[existingIndex].quantity;
            } else {
                // Add new item
                currentOrder.push(orderItem);
            }

            updateOrderDisplay();
            updateCartBadge();
            Swal.fire({
                title: 'Added to Order!',
                text: `${orderItem.quantity}x ${product.name} added to your order.`,
                icon: 'success',
                confirmButtonColor: '#A8A54A'
            });
        }

        // Function to update order display
        function updateOrderDisplay1() {
            const orderItemsContainer = document.getElementById('orderItems');
            const totalAmountElement = document.getElementById('totalAmount');

            if (currentOrder.length === 0) {
                orderItemsContainer.innerHTML = `
                                            <div class="empty-cart">
                                                <i class="fas fa-shopping-cart"></i>
                                                <p>Your cart is empty</p>
                                                <p>Add items from the menu to get started</p>
                                            </div>`;
                totalAmountElement.innerHTML = '&#8369; 0.00';
                totalAmountElement.textContent = '₱0.00';
                updateCartBadge();
                return;
            }

            let totalAmount = 0;
            let orderItemsHTML = '';

            currentOrder.forEach((item, index) => {
                totalAmount += item.totalPrice;

                let details = [];
                details.push(item.orderType.charAt(0).toUpperCase() + item.orderType.slice(1));

                if (item.addons.length > 0) {
                    details.push('Add-ons: ' + item.addons.map(a => a.name).join(', '));
                }

                orderItemsHTML += `
                                            <div class="order-item" data-id="${item.id}">
                                                <div class="order-item-image">
                                                    <img src="${item.image}" alt="${item.name}">
                                                </div>
                                                <div class="order-item-details">
                                                    <div class="order-item-name">${item.name}</div>
                                                    <div class="order-item-info">${details.join(' | ')}</div>
                                                    <div class="order-item-price">&#8369; ${item.totalPrice}.00</div>
                                                    <div class="order-item-quantity">
                                                        <button class="quantity-btn" onclick="updateQuantity(${index}, -1)">-</button>
                                                        <span class="quantity-value">${item.quantity}</span>
                                                        <button class="quantity-btn" onclick="updateQuantity(${index}, 1)">+</button>
                                                    </div>
                                                </div>
                                                <div class="order-item-actions">
                                                    <button class="order-item-action-btn edit-btn" onclick="editOrderItem(${index})">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="order-item-action-btn delete-btn" onclick="deleteOrderItem(${index})">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        `;
            });

            orderItemsContainer.innerHTML = orderItemsHTML;
            totalAmountElement.innerHTML = `&#8369; ${totalAmount}.00`;
            updateCartBadge();
        }

        // Function to update quantity
        function updateQuantity1(index, change) {
            const newQuantity = currentOrder[index].quantity + change;

            if (newQuantity < 1) {
                deleteOrderItem(index);
                return;
            }

            currentOrder[index].quantity = newQuantity;
            currentOrder[index].totalPrice =
                (currentOrder[index].unitPrice + currentOrder[index].addonsPrice) * newQuantity;

            updateOrderDisplay();
        }

        // Function to edit order item
        function editOrderItem1(index) {
            const item = currentOrder[index];
            const product = products.find(p => p.id === item.productId);
            showOrderModal(product.id);

            // After modal closes, we could auto-fill with existing values
            // For simplicity, we'll remove the old item and let user re-add with modifications
            setTimeout(() => {
                currentOrder.splice(index, 1);
                updateOrderDisplay();
            }, 100);
        }

        // Function to delete order item
        function deleteOrderItem1(index) {
            Swal.fire({
                title: 'Remove Item?',
                text: `Remove ${currentOrder[index].name} from your order?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6F4E37',
                confirmButtonText: 'Yes, remove it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    currentOrder.splice(index, 1);
                    updateOrderDisplay();
                    Swal.fire(
                        'Removed!',
                        'Item has been removed from your order.',
                        'success'
                    );
                }
            });
        }

